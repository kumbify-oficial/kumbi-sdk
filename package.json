{
  "name": "@kumbify/sdk",
  "version": "1.3.0",
  "description": "Oficial Kumbify SDK to integrate our services in your applications",
  "homepage": "https://github.com/kumbify-oficial/kumbi-sdk#readme",
  "bugs": {
    "url": "https://github.com/kumbify-oficial/kumbi-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumbify-oficial/kumbi-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "keywords": [
    "kumbify",
    "sms",
    "email",
    "oauth"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "ISC",
  "author": "Kumbify",
  "type": "module",
  "scripts": {
    "build": "npx tsup src --out-dir dist --minify --dts",
    "pack:change": "changeset",
    "pack:version": "changeset version",
    "pack:publish": "npm run build && changeset publish",
    "test:mail": "ts-node-dev ./src/clients/kmail/KMailClient.ts",
    "test:sms": "ts-node-dev ./src/clients/ksms/KSMSClient.ts",
    "test:payment": "ts-node-dev ./src/clients/payment/KPaymentClient.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^26.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "tsup": "^8.5.1"
  }
}
